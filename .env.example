# ======================================================================
#  KJV Rain Studio - environment configuration
#  Copy to .env and fill in. NEVER commit .env.
# ======================================================================

# --- YouTube Data API v3 (public reads: competitor research) -----------
# Google Cloud Console > APIs & Services > Credentials > API key
YOUTUBE_API_KEY=

# --- OAuth2 (uploads, analytics, thumbnails, playlists) ----------------
# Desktop-app OAuth client JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secret.json
YOUTUBE_TOKEN_FILE=config/token.json

# The channel the agents may publish to (YouTube Studio > Settings > Channel > Advanced > Channel ID,
# starts with "UC"). The agents NEVER create channels: they upload to the channel you choose on Google's
# consent screen during `python -m core.youtube_auth`. If the authorised channel differs from this ID,
# Agent 4 refuses to publish. Strongly recommended.
YOUTUBE_CHANNEL_ID=

# Daily quota you were granted (default project quota = 10,000 units)
YOUTUBE_DAILY_QUOTA=10000
# Units kept in reserve so uploads (1,600 units each) never get starved
YOUTUBE_QUOTA_RESERVE=2000

# --- Brand ---------------------------------------------------------------
# Leave blank to let Agent 1 propose a distinct name from its candidate list
BRAND_NAME=
BRAND_HANDLE=
BRAND_TAGLINE=
# Optional funnel link placed in descriptions / pinned comment
FUNNEL_URL=
FUNNEL_LABEL=Free printable sleep scripture guide

# --- TTS -------------------------------------------------------------------
# kokoro | piper | chatterbox | elevenlabs
TTS_ENGINE=kokoro
KOKORO_VOICE=am_michael
PIPER_MODEL_PATH=assets/voices/en_US-ryan-low.onnx
# Optional reference clip (5-15 s WAV) for Chatterbox voice cloning - use only a voice you own/licensed
CHATTERBOX_VOICE_PROMPT=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Rendering ---------------------------------------------------------------
# auto | h264_videotoolbox | h264_nvenc | libx264
VIDEO_ENCODER=auto
VIDEO_FPS=15

# Render a short preview instead of 8-10 h (seconds; 0 = full length). Great for --dry-run checks.
PREVIEW_SECONDS=0

# --- Publishing --------------------------------------------------------------
# private | unlisted | public  (start private until you have reviewed a few uploads)
DEFAULT_PRIVACY=private
# Scheduled publishing: upload private, YouTube makes it public at this local time (one long-form slot
# per day; Shorts are spread across the following hours). Pick it from YouTube Studio > Analytics >
# Audience > "When your viewers are on YouTube" - roughly 1-3 h before your audience's bedtime.
# Leave empty to use DEFAULT_PRIVACY immediately.
PUBLISH_TIME=
PUBLISH_TIMEZONE=America/New_York
# Subscriber notifications: on for long-form releases, off for Shorts (avoid 4 pings per release)
NOTIFY_SUBSCRIBERS_LONG=true
NOTIFY_SUBSCRIBERS_SHORTS=false
# AI narration voice -> YouTube "altered or synthetic content" disclosure (status.containsSyntheticMedia)
DISCLOSE_SYNTHETIC_MEDIA=true
# Resumable upload chunk size in MiB (rounded to a multiple of 256 KiB)
UPLOAD_CHUNK_MB=64
# Shorts per long-form release (each Short upload costs 1,600 quota units)
SHORTS_PER_RELEASE=3
# Keep the final MP4 this many days after YouTube finishes HD processing (0 = delete immediately)
KEEP_FINAL_VIDEO_DAYS=0

# --- Paths -------------------------------------------------------------------
DB_PATH=db/state.sqlite3
OUTPUT_DIR=output
BRAND_KIT_DIR=channel_brand_kit
LOG_LEVEL=INFO
